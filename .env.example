# Copy this file to .env and fill in real values. Never commit .env.
#
# Local use only: the READ-ONLY Cloudflare API token (Zone.DNS:Read, Zone.Zone:Read,
# scoped to only the zone(s) this project manages). Used for `dnscontrol preview` / `get-zones`.
# The WRITE token used by `dnscontrol push` lives only as a GitHub Actions Environment
# secret (CLOUDFLARE_API_TOKEN_WRITE) — engineers should never have it locally.
CLOUDFLARE_API_TOKEN=your-readonly-cloudflare-api-token-here

# Alternative to the line above: leave CLOUDFLARE_API_TOKEN unset here and instead set
# CLOUDFLARE_KEYVAULT_NAME so dnsctl.py fetches the read-only token from Azure Key Vault
# at runtime (via `az keyvault secret show`, requires `az login`) - never written to disk.
# Recommended once more than one person needs the token, so no token ever sits in a local
# file. See docs/security.md#key-vault-backed-tokens.
# CLOUDFLARE_KEYVAULT_NAME=your-vault-name
# CLOUDFLARE_KEYVAULT_SECRET_NAME=cloudflare-api-token-readonly   # optional, this is the default
