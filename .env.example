# Copy this file to .env and fill in real values. Never commit .env.
#
# Local use only: the READ-ONLY Cloudflare API token (Zone.DNS:Read, Zone.Zone:Read,
# scoped to only the zone(s) this project manages). Used for `dnscontrol preview` / `get-zones`.
# The WRITE token used by `dnscontrol push` lives only as a GitHub Actions Environment
# secret (CLOUDFLARE_API_TOKEN_WRITE) — engineers should never have it locally.
CLOUDFLARE_API_TOKEN=your-readonly-cloudflare-api-token-here
