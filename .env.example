# Copy this file to .env and fill in real values. Never commit .env.
#
# Local use only: the READ-ONLY Cloudflare API token (Zone.DNS:Read, Zone.Zone:Read,
# scoped to only the zone(s) this project manages). Used for `dnscontrol preview` / `get-zones`.
# The WRITE token used by `dnscontrol push` lives only as a GitHub Actions Environment
# secret (CLOUDFLARE_API_TOKEN_WRITE) — engineers should never have it locally.
CLOUDFLARE_API_TOKEN=your-readonly-cloudflare-api-token-here

# Alternative to the line above: leave CLOUDFLARE_API_TOKEN unset here and instead set
# CLOUDFLARE_KEYVAULT_NAME so dnsctl.py fetches the read-only token from Azure Key Vault
# at runtime (via `az keyvault secret show`, requires `az login`) - never written to disk.
# Recommended once more than one person needs the token, so no token ever sits in a local
# file. See docs/security.md#key-vault-backed-tokens.
# CLOUDFLARE_KEYVAULT_NAME=your-vault-name
# CLOUDFLARE_KEYVAULT_SECRET_NAME=cloudflare-api-token-readonly   # optional, this is the default

# --- Team/enterprise mode toggles ---------------------------------------------
# All "false"/unset by default so a solo home-lab setup sees no change in
# behavior. These are LOCAL, fast-feedback mirrors of checks CI enforces for
# real (REQUIRE_TICKET_REFERENCE in .github/workflows/preview.yml,
# REQUIRE_NON_AUTHOR_REVIEW in .github/workflows/apply.yml) - they make
# `dnsctl submit`/`dnsctl merge` fail immediately instead of waiting for a
# GitHub Actions run to report the same problem, but they are not themselves
# the enforcement: nothing stops someone from leaving these unset locally, so
# a team onboarding contractors must still flip the corresponding CI flag.
# See docs/making-changes.md#team-enterprise-mode-referencing-a-ticket and
# docs/DNS_Change_Process.md.
#
# Require `dnsctl submit`'s message/--body to contain a ticket reference
# (e.g. "[INC0012345]") before it will commit/push/open a PR at all.
# DNSCTL_REQUIRE_TICKET_REFERENCE=true
#
# Override the ticket ID regex if your ticketing system's format differs
# from the default "[PREFIX-1234]"/"[PREFIX1234]" style. Keep this in sync
# with TICKET_REFERENCE_PATTERN in .github/workflows/preview.yml so a
# message that passes locally also passes CI.
# DNSCTL_TICKET_REFERENCE_PATTERN=\[[A-Z][A-Z0-9]*-?[0-9]+\]
#
# Require `dnsctl merge` to see an APPROVED review from someone other than
# the PR author before it will merge at all, instead of only finding out
# after merge when the DNS Apply workflow's own REQUIRE_NON_AUTHOR_REVIEW
# check fails.
# DNSCTL_REQUIRE_NON_AUTHOR_REVIEW=true
