#!/usr/bin/env bash
# Local stand-in for server-side branch protection: this private repo can't
# use GitHub's required-status-check branch protection without GitHub Pro,
# so this hook enforces "dnscontrol preview must pass" before anything
# reaches main from this machine.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks

set -euo pipefail

protected_ref="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_ref" ]; then
    echo "pre-push: verifying dnscontrol preview before pushing to main..."

    if [ -f .env ]; then
      set -a
      # shellcheck disable=SC1091
      source .env
      set +a
    fi

    if ! command -v dnscontrol >/dev/null 2>&1; then
      echo "pre-push: dnscontrol not found in PATH — install it before pushing to main." >&2
      exit 1
    fi

    if ! dnscontrol preview; then
      echo "pre-push: dnscontrol preview failed — push to main blocked." >&2
      exit 1
    fi

    echo "pre-push: preview OK, proceeding with push to main."
  fi
done

exit 0
